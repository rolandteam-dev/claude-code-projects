+      const texts = await fub.textsForPerson(candidate.id, sinceIso);
+      consecutiveFailures = 0;
+
+      // Merge, never replace: the call history from the bulk pull is still good.
+      const fromTexts = buildTouchIndex({ texts }).get(candidate.id) ?? { lastOutbound: 0, lastInbound: 0 };
+      const prior = touchIndex.get(candidate.id) ?? { lastOutbound: 0, lastInbound: 0 };
