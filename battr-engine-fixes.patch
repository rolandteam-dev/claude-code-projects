+  assert.ok(failed, "it must exit non-zero, not carry on");
+  assert.match(stderr, /DRY RUN/);
+  assert.match(stderr, /never happened/);
+});
+
+check("undo does not report success it did not have", async () => {
+  // The client short-circuits writes in dry mode and returns {dry:true} rather
+  // than throwing, so this used to count every lead as restored and print
+  // "Restored 1/1 leads" having done nothing. A false all-clear is worse than a
+  // crash: the crash sends someone looking, the all-clear sends them to lunch.
+  mkdirSync(undoDir, { recursive: true });
+  const id = "2026-09-04-live1";
+  writeFileSync(
+    join(undoDir, `${id}.json`),
+    JSON.stringify({ runId: id, dry: false, sweeps: [{ personId: 1, name: "X", fromUserId: 5, fromUserName: "A" }] })
+  );
+  // FUB_API_BASE points at a closed port, so every restore genuinely fails.
+  const { failed, stderr } = await runUndo(id);
+  rmSync(join(undoDir, `${id}.json`), { force: true });
+
+  assert.ok(failed, "a partial undo leaves the database half-reversed and must exit non-zero");
+  assert.match(stderr, /still in the pond/);
+  assert.doesNotMatch(stderr, /Restored 1\/1/);
+});
+
+check("the undo is reachable from the workflow, not just from a laptop", () => {
+  // It existed in the code with no door into it. On the morning it was needed
+  // the only route would have been a clone of this repo and a copy of the key.
+  const yml = readFileSync(join(ROOT, ".github", "workflows", "battr-audit.yml"), "utf8");
+  assert.match(yml, /- "undo"/, "undo must be a choice in the task dropdown");
+  assert.match(yml, /run_id:/, "and must take the run id to reverse");
+  assert.match(yml, /--undo=/, "and must actually invoke it");
+  assert.match(yml, /test-email\|undo\)/, "and must pass the task allowlist");
+});
+
 // -------------------------------------------------- side-by-side with Battr
 //
 // The paid subscription is the only known-good answer this engine will ever
