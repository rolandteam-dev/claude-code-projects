+async function backfillTexts(fub, { results, peopleById, touchIndex, fields, sinceIso, combined, log }) {
+  const candidates = results.filter((r) => r.status === "at_risk" || r.status === "neglected");
+  const blocked = new Set();
+  const diag = { candidates: candidates.length, checked: 0, cleared: 0, failed: 0, overBudget: 0, gaveUp: false, firstError: null };
+
+  if (!candidates.length) return { results, blocked, diag };
+
+  const corrected = new Map();
+  let consecutiveFailures = 0;
+
+  for (const candidate of candidates) {
