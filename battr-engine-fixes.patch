+      if (status !== candidate.status) diag.cleared++;
+      corrected.set(candidate.id, { ...candidate, status, textRecheck: true });
+    } catch (err) {
+      diag.failed++;
+      diag.firstError ??= err.message;
+      consecutiveFailures++;
+      blocked.add(candidate.id);
+      if (consecutiveFailures >= TEXT_LOOKUP_GIVE_UP_AFTER) {
+        diag.gaveUp = true;
+        log(`  per-lead text lookup failed ${consecutiveFailures}x in a row — giving up for this run (${err.message})`);
