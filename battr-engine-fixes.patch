+      // Reclassify through the same combined list the first pass used, so the
+      // corrected status comes from the real rules rather than a threshold
+      // guessed at here. runCombinedList is per-contact, so a one-contact run
+      // gives the same answer it would inside the full population.
+      const contact = normalizeContact(person, merged, fields);
+      const record = runCombinedList([contact], combined, Date.now()).records[0];
+      const status = record?.status ?? candidate.status;
