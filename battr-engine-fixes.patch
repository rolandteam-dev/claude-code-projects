--- /dev/null
+++ b/scripts/battr/compare.mjs
@@ -0,0 +1,234 @@
+/**
+ * Side-by-side tracking against the paid Battr product.
+ *
+ * The team pays for Battr and runs this engine at the same time on the same
+ * database. That overlap is the only chance there will ever be to check this
+ * engine's answers against a known-good one — once the subscription lapses,
+ * there is nothing left to compare to and every future number has to be taken
+ * on faith. So the overlap gets recorded, night by night, rather than spot
+ * checked and remembered.
+ *
+ * Two halves:
+ *
+ *   OURS   written automatically every night by the audit. One row per list.
+ *   THEIRS typed in (or pasted from Battr's Aida Audits screen). Same shape.
+ *
+ * The file is a plain CSV on purpose. It has to be editable by a person with a
+ * spreadsheet and no tooling, six months from now, after everyone involved has
+ * forgotten how any of this works.
+ *
+ * Nothing in here acts on anything. It records, compares, and prints.
+ */
+import { readFileSync, writeFileSync, existsSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+
+export const COMPARISON_HEADER = [
+  "date",
+  "list_id",
+  "list_name",
+  "source",
+  "total",
+  "compliant",
+  "at_risk",
+  "neglected",
+];
+
+const csvEscape = (value) => {
+  const s = value === null || value === undefined ? "" : String(value);
+  return /[",\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+};
+
+/** Minimal CSV reader — handles quoted fields, which list names need (they contain commas). */
+export function parseCsv(text) {
+  const rows = [];
+  let row = [];
+  let field = "";
+  let quoted = false;
+
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else field += c;
+      continue;
+    }
+    if (c === '"') quoted = true;
+    else if (c === ",") { row.push(field); field = ""; }
+    else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
+    else if (c !== "\r") field += c;
+  }
+  if (field !== "" || row.length) { row.push(field); rows.push(row); }
+  return rows.filter((r) => r.some((cell) => cell !== ""));
+}
+
+/** Read the comparison file into objects. Returns [] when it does not exist yet. */
+export function loadComparison(path) {
+  if (!existsSync(path)) return [];
+  const rows = parseCsv(readFileSync(path, "utf8"));
+  if (!rows.length) return [];
+  const header = rows[0].map((h) => h.trim());
+  return rows.slice(1).map((cells) => {
+    const row = {};
+    header.forEach((key, i) => { row[key] = cells[i] ?? ""; });
+    for (const key of ["total", "compliant", "at_risk", "neglected"]) {
+      row[key] = row[key] === "" ? null : Number(row[key]);
+    }
+    row.list_id = Number(row.list_id);
+    return row;
+  });
+}
+
+/**
+ * Append tonight's rows, replacing any existing rows for the same
+ * (date, source) so a re-run corrects itself instead of double-counting.
+ */
+export function recordOurs(path, date, rows) {
+  const existing = loadComparison(path).filter(
+    (r) => !(r.date === date && r.source === "ours")
+  );
+  const merged = [...existing, ...rows.map((r) => ({ ...r, date, source: "ours" }))];
+  writeComparison(path, merged);
+  return merged;
+}
+
+export function writeComparison(path, rows) {
+  mkdirSync(dirname(path), { recursive: true });
+  const sorted = [...rows].sort(
+    (a, b) => a.date.localeCompare(b.date) || a.list_id - b.list_id || a.source.localeCompare(b.source)
+  );
+  const lines = [COMPARISON_HEADER.join(",")];
+  for (const row of sorted) {
+    lines.push(COMPARISON_HEADER.map((key) => csvEscape(row[key])).join(","));
+  }
+  writeFileSync(path, `${lines.join("\n")}\n`);
+}
+
+/**
+ * Pair ours against theirs for one date.
+ *
+ * A list Battr has no row for is reported as unmatched rather than skipped: a
+ * comparison that quietly drops the rows it cannot pair is how you end up
+ * believing the two systems agree on everything you happened to record.
+ */
+export function compareOn(rows, date) {
+  const ours = new Map();
+  const theirs = new Map();
+  for (const row of rows) {
+    if (row.date !== date) continue;
+    (row.source === "ours" ? ours : theirs).set(row.list_id, row);
+  }
+
+  const ids = [...new Set([...ours.keys(), ...theirs.keys()])].sort((a, b) => a - b);
+  return ids.map((id) => {
+    const a = ours.get(id);
+    const b = theirs.get(id);
+    const name = a?.list_name || b?.list_name || `list ${id}`;
+    if (!a || !b) {
+      return { list_id: id, list_name: name, ours: a ?? null, theirs: b ?? null, matched: false };
+    }
+    const drift = (mine, yours) => {
+      if (!Number.isFinite(mine) || !Number.isFinite(yours)) return null;
+      if (yours === 0) return mine === 0 ? 0 : 1;
+      return (mine - yours) / yours;
+    };
+    return {
+      list_id: id,
+      list_name: name,
+      ours: a,
+      theirs: b,
+      matched: true,
+      drift: {
+        total: drift(a.total, b.total),
+        at_risk: drift(a.at_risk, b.at_risk),
+        neglected: drift(a.neglected, b.neglected),
+      },
+    };
+  });
+}
+
+/** The dates that have BOTH sides recorded — the only ones worth trending. */
+export function comparableDates(rows) {
+  const byDate = new Map();
+  for (const row of rows) {
+    const entry = byDate.get(row.date) ?? { ours: 0, theirs: 0 };
+    entry[row.source === "ours" ? "ours" : "theirs"]++;
+    byDate.set(row.date, entry);
+  }
+  return [...byDate.entries()]
+    .filter(([, v]) => v.ours > 0 && v.theirs > 0)
+    .map(([date]) => date)
+    .sort();
+}
+
+const pct = (n) => (n === null || n === undefined ? "—" : `${n >= 0 ? "+" : ""}${Math.round(n * 100)}%`);
+
+/**
+ * Render the comparison as the report's markdown section.
+ *
+ * Sorted worst-drift first, because a table sorted by list id buries the one
+ * row that matters under fourteen that agree.
+ */
+export function renderComparison(rows, date, { tolerance = 0.1 } = {}) {
+  const lines = [];
+  const pairs = compareOn(rows, date);
+
+  lines.push("## Side by side with Battr");
+  lines.push("");
+
+  if (!pairs.length) {
+    lines.push("_No rows recorded for today yet._");
+    lines.push("");
+    return lines;
+  }
+
+  const theirsCount = pairs.filter((p) => p.theirs).length;
+  if (!theirsCount) {
+    lines.push(
+      `Our numbers for ${date} are recorded. **Battr's are not yet** — add them to \`battr-logs/comparison.csv\` ` +
+        `(one row per list, \`source\` = \`battr\`) and the drift appears here tomorrow.`
+    );
+    lines.push("");
+    lines.push("| List | Ours: total | At risk | Neglected |");
+    lines.push("| --- | ---: | ---: | ---: |");
+    for (const p of pairs) {
+      lines.push(`| ${p.list_name} | ${p.ours?.total ?? "—"} | ${p.ours?.at_risk ?? "—"} | ${p.ours?.neglected ?? "—"} |`);
+    }
+    lines.push("");
+    return lines;
+  }
+
+  const matched = pairs.filter((p) => p.matched);
+  const worst = (p) => Math.max(...[p.drift?.total, p.drift?.neglected].map((d) => Math.abs(d ?? 0)));
+  const ordered = [...matched].sort((a, b) => worst(b) - worst(a));
+  const off = ordered.filter((p) => worst(p) > tolerance);
+
+  lines.push(
+    off.length
+      ? `**${off.length} of ${matched.length} lists are more than ${Math.round(tolerance * 100)}% away from Battr.** Worst first.`
+      : `All ${matched.length} matched lists agree with Battr inside ${Math.round(tolerance * 100)}%.`
+  );
+  lines.push("");
+  lines.push("| List | Ours | Battr | Total drift | Neglected: ours / Battr |");
+  lines.push("| --- | ---: | ---: | ---: | --- |");
+  for (const p of ordered) {
+    const flag = worst(p) > tolerance ? " ⚠️" : "";
+    lines.push(
+      `| ${p.list_name}${flag} | ${p.ours.total ?? "—"} | ${p.theirs.total ?? "—"} | ${pct(p.drift.total)} | ` +
+        `${p.ours.neglected ?? "—"} / ${p.theirs.neglected ?? "—"} |`
+    );
+  }
+  lines.push("");
+
+  const unmatched = pairs.filter((p) => !p.matched);
+  if (unmatched.length) {
+    lines.push(
+      `_${unmatched.length} list(s) recorded on only one side: ` +
+        unmatched.map((p) => `${p.list_name} (${p.ours ? "ours only" : "Battr only"})`).join(", ") +
+        "._"
+    );
+    lines.push("");
+  }
+
+  return lines;
+}
