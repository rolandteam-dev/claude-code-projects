# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# Owner connection. Runs migrations and the few legitimately cross-tenant
# paths (cron runner, inbound webhook tenant resolution). Bypasses RLS.
DATABASE_URL="postgresql://user:password@host/dealdesk?sslmode=require"

# Restricted runtime connection. RLS is FORCEd on this role, so a forgotten
# team filter cannot leak another tenant's data. REQUIRED in production.
# Create it once with the SQL in the README ("Enforcing tenant isolation").
DATABASE_URL_APP="postgresql://dealdesk_app:password@host/dealdesk?sslmode=require"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# Shared secret for /api/cron/* routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Auth (Clerk) — optional for local development
# ---------------------------------------------------------------------------
# Leave both blank to run locally with the dev auth bypass below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Local-only bypass: signs you in as this seeded user with no Clerk account.
# Ignored — and refused — when NODE_ENV=production.
DEV_AUTH_EMAIL="mike@therolandteam.com"

